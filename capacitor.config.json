{
  "appId": "com.allergyguard.app",
  "appName": "AllergyGuard",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "BarcodeScanner": {
      "lensFacing": "back"
    },
    "SpeechRecognition": {
      "language": "ko-KR"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0a0a0a"
  },
  "android": {
    "backgroundColor": "#0a0a0a"
  }
}
